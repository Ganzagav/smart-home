# Copy this file to ".env" and change the values to match your computer.

# PostgreSQL connection string:
#   Local:  postgresql://postgres:postgres@localhost:5432/iot_led_db
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iot_led_db"

# Port the Express API listens on (Render sets this automatically)
PORT=5000

# Simple shared secret. The ESP32 must send this in the "x-device-key" header.
# Change it, and put the same value in the ESP32 sketch.
DEVICE_API_KEY="esp32-secret-123"
